{
 "profile": "tabular-data-package",
 "name": "sa-financial-ombudsman-decisions",
 "title": "South African financial ombudsman determinations, 2005–2025",
 "description": "A name-free index of every determination published by the National Financial Ombud Scheme (NFO) and the FAIS Ombud: outcome, topic on two axes, statutory provisions verified verbatim, and a link to the ombud’s own publication. The determinations themselves remain the offices’ documents; this package indexes and cites them and reproduces none of their text.",
 "version": "1.0.0",
 "created": "2026-11-23",
 "keywords": [
  "south africa",
  "ombudsman",
  "financial services",
  "complaints",
  "fais",
  "nfo",
  "open data"
 ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ombudsman-data/schema/document.schema.json",
  "title": "document — one row of sources.jsonl / sources.public.jsonl (schema v0)",
  "type": "object",
  "required": ["doc_id", "url", "fetch_url", "sha256", "fetched_at", "bytes", "office", "division",
               "doc_type", "period_covered", "pages", "producer", "fonts_have_tounicode",
               "has_text_layer", "restricted_fields"],
  "properties": {
    "doc_id": {"type": "string", "pattern": "^(nfo-[0-9]+(-[0-9]+)?|nfo-doc-[a-z0-9-]+|fais-(det-[0-9a-f]{12}|ar-[0-9]{4}-[0-9]{2}|nl-[a-z0-9-]+|cs-[a-z0-9-]+))$"},
    "url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "fetch_url": {"type": ["string", "null"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "bytes": {"type": "integer", "minimum": 1},
    "office": {"enum": ["NFO", "FAIS"]},
    "division": {"enum": ["OLTI", "OBS", "OSTI", "CO", "NFO", "FAIS", null]},
    "doc_type": {"enum": ["determination", "recommendation", "annual_report", "financial_statements",
                          "trend_report", "newsletter", "digest"]},
    "period_covered": {"type": ["string", "null"],
                       "pattern": "^([0-9]{4}|[0-9]{4}/[0-9]{2}|[0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{4}-[0-9]{2}/[0-9]{4}-[0-9]{2})$"},
    "pages": {"type": ["integer", "null"], "minimum": 1},
    "producer": {"type": ["string", "null"]},
    "fonts_have_tounicode": {"type": ["boolean", "null"]},
    "has_text_layer": {"type": ["boolean", "null"]},
    "year": {"type": ["integer", "null"], "minimum": 1990, "maximum": 2100},
    "language": {"type": ["string", "null"], "pattern": "^[a-z]{2,3}$"},
    "filename_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "cmap_hole_count": {"type": ["integer", "null"], "minimum": 0},
    "suspect": {"type": "boolean"},
    "suspect_reasons": {"type": "array", "items": {"enum": ["no_text_layer", "quartz_cmap_holes",
      "no_tion_in_long_english_text", "many_suspect_tokens", "replacement_chars", "unreadable_pdf"]}},
    "restricted_fields": {"type": "array", "items": {"type": "string"}},
    "restricted": {"type": ["object", "null"], "required": ["restricted"],
                   "properties": {"restricted": {"const": true}}}
  },
  "allOf": [
    {"if": {"properties": {"doc_id": {"pattern": "^fais-det-"}}},
     "then": {"required": ["filename_sha256"],
              "properties": {"url": {"const": "https://www.faisombud.co.za/determinations/"},
                             "restricted_fields": {"contains": {"const": "fetch_url"}}}}}
  ]
}
